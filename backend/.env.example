# ---------------------------------------------------------------------------
# Smart Lecture Room Notification System — backend environment
# Copy to backend/.env. Never commit the real .env.
# ---------------------------------------------------------------------------

# Change this in production. All sessions and display links derive from it.
SECRET_KEY=change-me-to-a-long-random-value

# SQLite (zero setup, used by the pilot demo)
# SQLALCHEMY default: backend/instance/smart_rooms.db
# MySQL 8 (production):
# DATABASE_URL=mysql+pymysql://smartroom:password@127.0.0.1:3306/smart_rooms?charset=utf8mb4

# Set true when serving over HTTPS.
COOKIE_SECURE=false
INACTIVITY_MINUTES=15

# Public display security. Set true in production; the console then issues
# signed read-only display links.
DISPLAY_REQUIRE_TOKEN=false
DISPLAY_TOKEN_MAX_AGE_SEC=2592000

BUILDING_NAME=Building A
BUILDING_LABEL=LECTURE ROOMS

# browser = display screen speaks via Web Speech API (default, no install)
# command = run TTS_COMMAND, log = silent log only
TTS_ADAPTER=browser
TTS_COMMAND=

# Auto-create tables and demo officers/rooms on first run.
AUTO_INIT_DB=true
AUTO_SEED=true
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin@123
DEFAULT_OFFICER_USERNAME=otieno
DEFAULT_OFFICER_PASSWORD=Officer@123
